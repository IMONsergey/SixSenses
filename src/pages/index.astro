---
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { imageSizes, wellbeingImageSizes, collageImageSizes } from '../data/image-sizes';
import {asset} from '../data/assets';
import {units,gallery,travel,wellbeing,residenceCopy} from '../data/content';
import Action from '../components/Action.astro';
import Logo from '../components/Logo.astro';
import FloorPlan from '../components/FloorPlan.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import '../styles/global.css';
import '../styles/page.css';
const config={units,gallery};
const canonical=new URL('/',Astro.site).href;
const nav=[['home','Main'],['about','About'],['location','Location'],['layouts','Layouts'],['infrastructure','Infrastructure'],['investment','Investments'],['contact','Contacts']];
const collage=[
 {name:'imgRectangle147',alt:'Dubai Marina waterfront',class:'collage__marina'},
 {name:'imgRectangle148',alt:'Golf course and city views from a residence',class:'collage__golf'},
 {name:'imgRectangle149',alt:'Warm natural materials in a residence interior',class:'collage__living'},
 {name:'imgRectangle150',alt:'Six Senses tower at sunrise',class:'collage__tower'},
 {name:'imgRectangle153',alt:'Architectural details of the residential tower',class:'collage__detail'},
 {name:'imgRectangle151',alt:'Residence kitchen and living space',class:'collage__kitchen'},
 {name:'imgRectangle154',alt:'Six Senses entrance and landscaping',class:'collage__arrival'}
];
---
<!doctype html><html lang="en"><head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="theme-color" content="#070e1f" />
<title>Six Senses Residences Dubai Marina | Explore the residences</title>
<meta name="description" content="Discover Six Senses Residences Dubai Marina: architecture, elegant residences, wellbeing and skyline views. Explore Triplex A and Duplex B1 floor plans and register your interest." />
<link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} />
<link rel="icon" type="image/webp" href={asset('1:350','imgRectangle95')} />
<meta property="og:title" content="Six Senses Residences Dubai Marina" /><meta property="og:description" content="A new unrivaled complex in Dubai's iconic neighborhood." /><meta property="og:type" content="website" />
<link rel="preload" href="/fonts/foglihten-no06.woff2" as="font" type="font/woff2" crossorigin /><link rel="preload" href="/fonts/graphik-light.woff2" as="font" type="font/woff2" crossorigin />
</head><body class="six-page">
<a class="skip-link" href="#main-content">Skip to content</a>
<div class="intro" aria-hidden="true"><Logo decorative /><span class="intro__line"></span></div>
<header class="site-header">
  <nav class="desktop-nav" aria-label="Main navigation">{nav.map(([id,label])=><a href={`#${id}`}>{label}</a>)}</nav>
  <a class="header-logo" href="#home" aria-label="Six Senses Residences Dubai Marina, home"><Logo decorative /></a>
  <button class="header-register" type="button" data-enquire="Six Senses Residences Dubai Marina"><span>Register your interest</span><span aria-hidden="true">→</span></button>
  <button class="menu-toggle" type="button" data-modal="menu-dialog" aria-label="Open navigation" aria-controls="menu-dialog" aria-expanded="false"><span></span><span></span></button>
  <div class="reading-progress" aria-hidden="true"></div>
</header>
<main id="main-content" tabindex="-1">
  <section class="chapter hero" id="home" aria-labelledby="hero-title" data-story="hero" data-duration="2.3" data-base-view="0" data-node-id="1:350">
    <div class="chapter__stage">
      <div class="hero__primary state-primary">
        <img class="hero__photo" src={asset('1:350','imgSunrisePalmView')} alt="Six Senses Residences tower overlooking Palm Jumeirah at sunrise" width="1440" height="939" fetchpriority="high" />
        <div class="hero__shade"></div>
        <h1 id="hero-title">A new unrivaled <br />complex in Dubai’s <br />iconic neighborhood</h1>
        <dl class="hero-metrics"><div><dt>Residence collection</dt><dd>2–5 <span>bedrooms</span></dd></div><div><dt>Current prices</dt><dd>On <span>request</span></dd></div><div><dt>Availability</dt><dd><span>Enquire</span> today</dd></div></dl>
      </div>
      <div class="hero__invitation state-secondary" data-node-id="1:465">
        <img src={asset('1:466','imgPalmViewjpg')} alt="The lower tower and Six Senses entrance" width="1440" height="937" />
        <div class="invitation-card"><h2>Luxury<br />Residences<br />presents the<br /><span>long-awaited<br />complex</span></h2><div class="invitation-card__brand"><span><ResponsiveImage src={asset('1:480','imgSsrDubaiMarinaStandardLogoWhite1')} alt="Six Senses Residences Dubai Marina" sizes={imageSizes.invitationLogo} /></span></div></div>
      </div>
      <div class="chapter-controls" aria-label="Introduction views"><button type="button" data-story-switch="0" aria-pressed="true">The vision</button><span>/</span><button type="button" data-story-switch="1" aria-pressed="false">An invitation</button></div>
    </div>
  </section>

  <section class="chapter about" id="about" aria-labelledby="about-title" data-story="about" data-duration="3.1" data-base-view="0" data-node-id="1:489">
    <div class="chapter__stage">
      <div class="about__overview state-primary">
        <div class="about__photo"><ResponsiveImage src={asset('1:489','imgPalmViewjpg')} alt="The sculpted crown of the Six Senses tower" width="720" height="937" loading="lazy" sizes={imageSizes.about} /></div>
        <div class="about__heading"><h2 id="about-title">This incredible project that will be <span>the world’s tallest residential tower</span></h2></div>
        <div class="about__copy"><p>A project that will change Dubai’s skyline forever.<br />And will establish new levels of luxury for its elite residents.</p><p>{residenceCopy}</p></div>
        <Action class="scene-action" label="Find current prices" context="Current prices and availability" />
      </div>
      <div class="about__architecture state-secondary" data-node-id="1:509">
        <div class="architecture-photo"><ResponsiveImage src={asset('1:510','imgStreetView02')} alt="The elegant silhouette of the Six Senses tower rising into the sky" loading="lazy" sizes={imageSizes.architecture} /></div>
        <h3><span>The</span><span>elegance</span><span>of the future</span></h3>
        <div class="architecture-copy architecture-copy--left"><div class="architecture-emblem" aria-hidden="true"><img src="/assets/1-527-original.svg" alt="" /></div><p>The building’s exterior façade with its sophisticated silhouette is the epitome of refined elegance, blending seamlessly with the dynamic landscape of Dubai Marina. It emphasizes its unique character, deservedly taking its place as a timeless landmark of the city.</p></div>
        <div class="architecture-copy architecture-copy--right"><div class="skyline-illustration" aria-hidden="true"><img src="/assets/1-532-original.svg" alt="" /></div><p>Embodying the design philosophy and ‘city of the future’ concept, Six Senses Residences Dubai Marina rises on the world stage as the tallest residential tower of our time.</p></div>
      </div>
      <div class="chapter-controls" aria-label="About views"><button type="button" data-story-switch="0" aria-pressed="true">The project</button><span>/</span><button type="button" data-story-switch="1" aria-pressed="false">Architecture</button></div>
    </div>
  </section>

  <section class="chapter location" id="location" aria-labelledby="location-title" data-story="location" data-duration="2.2" data-base-view="1" data-node-id="1:957">
    <div class="chapter__stage">
      <div class="location__entry state-primary"><img src={asset('1:821','imgRectangle147')} alt="Dubai Marina and its waterfront neighborhood" loading="lazy" /><div class="entry-shade"></div><p class="entry-title" aria-hidden="true">Luxury address<br />in the heart<br />of Dubai Marina</p></div>
      <div class="location__details state-secondary" data-node-id="1:546">
        <div class="location-map"><ResponsiveImage src={asset('1:546','imgGroup10000033231')} alt="Map showing Six Senses Residences in Dubai Marina, close to Palm Jumeirah, Bluewaters and the city's landmarks" loading="lazy" sizes={imageSizes.map} /></div>
        <div class="location-copy"><h2 id="location-title">Luxury address<br />in the heart<br />of Dubai Marina</h2><p>A stay at Six Senses Residences Dubai Marina provides privileged access to the heart of the city - Dubai Marina, the epitome of the perfect lifestyle for connoisseurs of energy and harmony.</p><div class="travel-grid">{travel.map(item=><article><h3>{item.time}</h3><ul>{item.places.map(place=><li>{place}</li>)}</ul></article>)}</div><Action label="Find current prices" context="Dubai Marina location and availability" /></div>
        <button class="map-zoom" type="button" data-location-zoom aria-label="Enlarge the location map">Enlarge map <span aria-hidden="true">↗</span></button>
      </div>
      <div class="chapter-controls" aria-label="Location views"><button type="button" data-story-switch="0" aria-pressed="false">The neighborhood</button><span>/</span><button type="button" data-story-switch="1" aria-pressed="true">Connections</button></div>
    </div>
  </section>

  <section class="chapter layouts" id="layouts" aria-labelledby="layouts-title" data-story="layouts" data-duration="2.3" data-base-view="1" data-node-id="1:939">
    <div class="chapter__stage">
      <div class="layouts__entry state-primary"><ResponsiveImage src={asset('1:939','imgRectangle107')} alt="" loading="lazy" sizes={imageSizes.layoutBack} /><ResponsiveImage src={asset('1:939','imgRectangle108')} alt="Panoramic views from a Six Senses residence" loading="lazy" sizes={imageSizes.layoutView} /><div class="entry-shade"></div><p class="entry-title" aria-hidden="true">A variety<br />of layouts<br />spaces</p></div>
      <div class="layouts__details state-secondary" data-node-id="1:594">
        <div class="chapter-aside"><h2 id="layouts-title">A variety<br />of layouts<br />spaces</h2><p>{residenceCopy}</p><Action light label="Find current prices" context="Residence layouts and current prices" /></div>
        <div class="layout-cards" aria-label="Residence layouts">{units.map(unit=><article class={`layout-card layout-card--${unit.id}`} data-node-id={unit.sourceNode}><div class="layout-card__details"><h3><button type="button" data-unit={unit.id}>{unit.name}</button></h3><div class="layout-card__meta"><span>{unit.bedrooms} bedrooms</span><span>Levels {unit.levels}</span></div><dl class="area-table"><div><dt>Apartment area</dt><dd>{unit.apartment} m²</dd></div><div><dt>Balcony area</dt><dd>{unit.balcony} m²</dd></div><div><dt>Total area</dt><dd>{unit.total} m²</dd></div></dl></div><button class="layout-card__plan" type="button" data-unit={unit.id} aria-label={`View ${unit.name} floor plans`}><FloorPlan type={unit.id} /><span class="layout-card__zoom" aria-hidden="true">↗</span></button><button type="button" class="layout-card__view" data-unit={unit.id}>Explore the residence <span aria-hidden="true">→</span></button></article>)}</div>
        <div class="layout-controls"><button class="round-button" type="button" data-layout-prev aria-label="Previous layout">←</button><span data-layout-count aria-live="polite">1 / 2</span><button class="round-button" type="button" data-layout-next aria-label="Next layout">→</button></div>
      </div>
      <div class="chapter-controls" aria-label="Layout views"><button type="button" data-story-switch="0" aria-pressed="false">The outlook</button><span>/</span><button type="button" data-story-switch="1" aria-pressed="true">The residences</button></div>
    </div>
  </section>

  <section class="chapter interiors" id="interiors" aria-labelledby="interiors-title" data-story="interiors" data-duration="2.3" data-base-view="1" data-node-id="1:921">
    <div class="chapter__stage">
      <div class="interiors__entry state-primary"><ResponsiveImage src={asset('1:921','imgImage6')} alt="The tranquil terrace and pool of a Six Senses residence" loading="lazy" sizes={imageSizes.interiorEntry} /><div class="entry-shade"></div><p class="entry-title" aria-hidden="true">Explore the<br />elegant spaces<br />of Six Senses<br />Residences<br />Dubai Marina</p></div>
      <div class="interiors__details state-secondary" data-node-id="1:900">
        <div class="chapter-aside"><h2 id="interiors-title">Explore the elegant spaces of Six Senses Residences Dubai Marina</h2><Action light label="Find current prices" context="Residence interiors and specifications" /></div>
        <div class="gallery" role="region" aria-roledescription="carousel" aria-label="Residence interiors" tabindex="0"><button class="gallery__main" type="button" data-gallery-zoom aria-label="Enlarge the interior photograph"><img data-gallery-image src={gallery[0].image} alt={gallery[0].alt} width="850" height="530" loading="lazy" /><span aria-hidden="true">↗</span></button><button class="gallery__preview" type="button" data-gallery-next aria-label="View the next interior photograph"><img data-gallery-preview src={gallery[1].image} alt={gallery[1].alt} width="850" height="530" loading="lazy" /></button><div class="gallery__controls"><span aria-live="polite"><span data-gallery-current>1</span> / {gallery.length}</span><button class="round-button" type="button" data-gallery-prev aria-label="Previous interior photograph">←</button><button class="round-button" type="button" data-gallery-next aria-label="Next interior photograph">→</button></div></div>
      </div>
      <div class="chapter-controls" aria-label="Interior views"><button type="button" data-story-switch="0" aria-pressed="false">Open spaces</button><span>/</span><button type="button" data-story-switch="1" aria-pressed="true">Inside</button></div>
    </div>
  </section>

  <section class="chapter wellbeing" id="infrastructure" aria-labelledby="wellbeing-title" data-story="wellbeing" data-duration="2.5" data-base-view="0" data-node-id="1:714">
    <div class="chapter__stage">
      <div class="wellbeing__details state-primary"><div class="chapter-aside"><h2 id="wellbeing-title">Premium-class<br />infrastructure</h2><p>Residents have access to an extensive array of amenities, divided into four levels totaling 5,688 square meters. Each of these levels is designed to enhance the quality of life, health and harmony between people.</p><Action label="Find current prices" context="Wellbeing and residence amenities" /></div><div class="wellbeing-cards">{wellbeing.map(item=><article data-node-id={item.node}><button type="button" data-photo={item.image} data-photo-title={item.title} aria-label={`Enlarge ${item.title} amenity photograph`}><ResponsiveImage src={item.image} alt={item.title==='Interaction'?'A serene shared space with natural materials and an olive tree':'The fitness and wellbeing space with sculptural stairs and full-height windows'} width="410" height="442" loading="lazy" sizes={wellbeingImageSizes[item.title]} /><span aria-hidden="true">↗</span></button><h3>{item.title}</h3><p>{item.copy}</p></article>)}</div></div>
      <div class="wellbeing__closing state-secondary" data-node-id="1:805"><div><ResponsiveImage src={asset('1:805','imgMarinaSkylineView2')} alt="Dubai Marina skyline at dusk" loading="lazy" sizes={imageSizes.skyline} /></div><h3>Enriches<br />daily life<br />with the<br />pursuit<br />of total<br />well-being</h3></div>
      <div class="chapter-controls" aria-label="Wellbeing views"><button type="button" data-story-switch="0" aria-pressed="true">Balance &amp; interaction</button><span>/</span><button type="button" data-story-switch="1" aria-pressed="false">Well-being</button></div>
    </div>
  </section>

  <section class="chapter investment" id="investment" aria-labelledby="investment-title" data-story="investment" data-duration="2.4" data-base-view="0" data-node-id="1:752">
    <div class="chapter__stage">
      <div class="investment__details state-primary"><div class="chapter-aside"><h2 id="investment-title"><span>Investment attractiveness</span> of Six Senses</h2><div class="documents">{['Floor plans','Payment plan','Property promo'].map(label=><button type="button" data-enquire={`${label} request`}><span>{label}<small>Request the document</small></span><span class="document-arrow" aria-hidden="true"><img src={asset('1:752','imgEllipse6167')} alt="" /><img src={asset('1:752','imgVector388')} alt="" /></span></button>)}</div><p>Request the latest project documents, payment terms and availability for Six Senses Residences Dubai Marina.</p><Action label="Find current prices" context="Investment information and current terms" /></div><div class="investment-metrics"><article><p>Explore the supplied residence layouts and request current prices</p><h3>On <span>request</span></h3></article><article><p>Review specifications and availability for your preferred residence</p><h3><span>Floor</span> plans</h3><small>Illustrative project layouts</small></article><article><p>Ask for the current payment schedule and supporting documents</p><h3><span>Latest</span> terms</h3><small>Subject to confirmation</small></article><p class="source-note">Images and layouts are project materials. Prices, availability and investment terms require current confirmation. Investment returns are not guaranteed.</p></div></div>
      <div class="investment__closing state-secondary" data-node-id="1:821"><div class="investment-collage">{collage.map(item=><div class={item.class}><ResponsiveImage src={asset('1:821',item.name)} alt={item.alt} loading="lazy" sizes={collageImageSizes[item.class]} /></div>)}</div><h3>Your path<br /><span>to successful<br />investments</span><br />and limitless<br />opportunities</h3></div>
      <div class="chapter-controls" aria-label="Investment views"><button type="button" data-story-switch="0" aria-pressed="true">The opportunity</button><span>/</span><button type="button" data-story-switch="1" aria-pressed="false">The possibilities</button></div>
    </div>
  </section>

  <section class="contact" id="contact" aria-labelledby="contact-form-title" data-node-id="1:844"><div class="contact__panel"><div class="contact__image"><ResponsiveImage class="contact__tower" src={asset('1:844','imgRectangle139')} alt="Six Senses residential tower overlooking Dubai Marina" loading="lazy" sizes={imageSizes.contact} /><div class="contact__image-shade"></div><div class="contact-logo" role="img" aria-label="Six Senses Residences Dubai Marina"><img class="contact-logo__symbol" src={asset('1:844','imgRectangle95')} alt="" /><span><ResponsiveImage src={asset('1:844','imgSsrDubaiMarinaStandardLogoWhite1')} alt="" sizes={imageSizes.contactLogo} /></span></div></div><EnquiryForm id="contact-form" /></div></section>
</main>
<footer class="site-footer"><span>Six Senses Residences Dubai Marina</span><div><button type="button" data-privacy>Privacy Policy</button><button type="button" data-terms>Terms &amp; Conditions</button><a href="#home">Back to top ↑</a></div></footer>

<dialog id="menu-dialog" class="sheet menu-sheet" aria-labelledby="menu-title"><button class="close-button" type="button" data-close aria-label="Close navigation">×</button><h2 id="menu-title" class="sr-only">Explore Six Senses</h2><Logo decorative /><nav aria-label="Mobile navigation">{nav.map(([id,label])=><a href={`#${id}`}>{label}</a>)}<a href="#interiors">Interiors</a></nav><Action label="Register your interest" context="Six Senses Residences Dubai Marina" /></dialog>
<dialog id="unit-dialog" class="sheet unit-sheet" aria-labelledby="unit-title"><button class="close-button" type="button" data-close aria-label="Close residence details">×</button><div class="unit-sheet__inner"><button class="back-link" type="button" data-close>← Back to layouts</button><div class="unit-nav" aria-label="Residence type">{units.map(u=><button type="button" data-unit={u.id} aria-pressed="false">{u.name}</button>)}</div><div class="unit-heading"><p class="eyebrow">Six Senses Residences Dubai Marina</p><h2 id="unit-title">Unit 01 | Triplex A</h2></div>{units.map(u=><article class={`unit-detail unit-detail--${u.id}`} data-unit-panel={u.id} hidden={u.id!=='triplex'}><div class="unit-detail__plan"><button class="unit-plan-button" type="button" data-plan-zoom={u.id} aria-label={`Enlarge ${u.name} plans`}><FloorPlan type={u.id} /><span class="zoom-label">Enlarge floor plans ↗</span></button><div class="level-labels">{u.levelNames.map(l=><span>{l}</span>)}</div><p>Sea / Skyline / Palm · Golf / City Urban</p></div><div class="unit-detail__specs"><h3>{u.bedrooms} bedrooms</h3><p class="unit-levels">Levels {u.levels}</p><dl class="area-table"><div><dt>Apartment area</dt><dd>{u.apartment} m²</dd></div><div><dt>Balcony area</dt><dd>{u.balcony} m²</dd></div><div><dt>Total area</dt><dd>{u.total} m²</dd></div></dl><p class="unit-note">Explore this layout and enquire about current availability and specifications.</p><button class="register-button" type="button" data-enquire={u.name}><span>Register your interest</span><span aria-hidden="true">→</span></button></div></article>)}</div></dialog>
<dialog id="zoom-dialog" class="sheet zoom-sheet" aria-labelledby="zoom-title"><button class="close-button" type="button" data-close aria-label="Close enlarged image">×</button><h2 id="zoom-title">Floor plans</h2><div class="zoom-toolbar" aria-label="Image zoom"><button type="button" data-zoom-out aria-label="Zoom out">−</button><button type="button" data-zoom-reset>Fit</button><button type="button" data-zoom-in aria-label="Zoom in">+</button></div><div class="zoom-stage" tabindex="0" aria-label="Enlarged image. Use plus or minus to zoom, and arrow keys or drag to pan."><div class="zoom-canvas"><img data-zoom-image alt="Triplex A floor plans" /></div></div><p class="zoom-hint">Use + / − to zoom. Drag to explore. Escape to return.</p></dialog>
<dialog id="enquiry-dialog" class="sheet enquiry-sheet" aria-labelledby="modal-form-title"><button class="close-button" type="button" data-close aria-label="Close enquiry">×</button><div class="enquiry-modal__layout"><aside class="enquiry-modal__context"><p class="eyebrow">Six Senses Residences Dubai Marina</p><h3>Explore a new<br />perspective</h3><ResponsiveImage src={asset('1:821','imgRectangle148')} alt="Open city views from a residence" loading="lazy" sizes={imageSizes.enquiry} /><p>Share your interest and the website owner can follow up with you.</p><button class="back-link" type="button" data-close>← Return to the residences</button></aside><EnquiryForm id="modal-form" modal /></div></dialog>
<dialog id="privacy-dialog" class="sheet small-sheet" aria-labelledby="privacy-title"><button class="close-button" type="button" data-close aria-label="Close privacy policy">×</button><h2 id="privacy-title">Privacy Policy</h2><p>Your enquiry is saved privately for the owner of this website to review and respond to your request.</p><p>We collect the name, email address, phone number, country, selected interest and message that you choose to submit. This form does not send your details directly to the property developer or third-party agents.</p><p>Only provide information you want the website owner to use for this enquiry. You can request correction or deletion by replying to the response to your request.</p></dialog>
<dialog id="terms-dialog" class="sheet small-sheet" aria-labelledby="terms-title"><button class="close-button" type="button" data-close aria-label="Close terms">×</button><h2 id="terms-title">Terms &amp;<br />Conditions</h2><p>This website presents Six Senses Residences Dubai Marina project information. Illustrations and floor plans are provided for exploration. The displayed figures are not a live inventory, price quotation or reservation offer.</p><p>Request current availability, specifications, prices and investment terms before making a decision. Submitting a form expresses interest and permits the website owner to contact you about that enquiry; it does not make a booking or purchase.</p></dialog>
<script id="six-data" type="application/json" set:html={JSON.stringify(config).replace(/</g,'\\u003c')} />
<script>import '../scripts/main';</script>
</body></html>
